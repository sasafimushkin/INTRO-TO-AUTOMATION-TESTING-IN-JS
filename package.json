{
  "name": "wdio-epam-ui-tests",
  "version": "1.0.0",
  "description": "UI test automation framework for epam.com built with WebdriverIO",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:chrome": "cross-env BROWSERS=chrome wdio run ./wdio.conf.js",
    "test:firefox": "cross-env BROWSERS=firefox wdio run ./wdio.conf.js",
    "test:headless": "cross-env HEADLESS=true wdio run ./wdio.conf.js",
    "test:demo-fail": "cross-env DEMO_FAIL=true wdio run ./wdio.conf.js",
    "report:html": "node ./scripts/generate-html-report.js",
    "report:generate": "node ./scripts/generate-html-report.js",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "open ./reports/index.html || allure open allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.33.1",
    "@wdio/cli": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "allure-commandline": "^2.46.1",
    "cross-env": "^7.0.3"
  }
}
