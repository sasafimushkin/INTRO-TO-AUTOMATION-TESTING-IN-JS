{
  "name": "unit-testing-framework",
  "version": "1.0.0",
  "description": "Unit testing framework with Mocha, Chai, Mochawesome, c8, and ESLint",
  "author": "Oleksandr Fimushkin",
  "scripts": {
    "test": "mocha --reporter mochawesome",
    "coverage": "c8 --reporter=text --reporter=html mocha",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^4.3.7",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "mocha": "^10.7.3",
    "mochawesome": "^7.1.3"
  }
}
